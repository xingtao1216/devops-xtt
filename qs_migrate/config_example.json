{
  "datasource_credentials": {
    "source-datasource-id": {
      "credential_type": "CREDENTIAL_PAIR",
      "username": "your_username",
      "password": "your_password"
    }
  },
  "datasource_parameters": {
    "source-datasource-id": {
      "RedshiftParameters": {
        "Host": "your-redshift-host.region.redshift.amazonaws.com",
        "Port": 5439,
        "Database": "your_database"
      }
    }
  },
  "vpc_connections": {
    "source-vpc-connection-id": {
      "SubnetIds": ["subnet-aaaa1111", "subnet-bbbb2222"],
      "SecurityGroupIds": ["sg-cccc3333"],
      "RoleArn": "arn:aws:iam::123456789012:role/your_quicksight_role"
    }
  }
}
